<Page x:Class="Pr3_snake.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Pr3_snake.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" 
      d:DesignWidth="800"
      Title="Home">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Pr3_snake;component/Images/img_backgroung.png"/>
        </Grid.Background>

        <Grid>
            <Grid Width="389" Height="398" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Background>
                    <ImageBrush ImageSource="/Pr3_snake;component/Images/img_scroll.png"/>
                </Grid.Background>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label
    Content="Your IP address:"
    HorizontalAlignment="Left"
    Margin="8,20,0,0"
    VerticalAlignment="Top"
    Foreground="Black"
    FontFamily="Forte"/>
                    <Label
    Content="Port:"
    HorizontalAlignment="Left"
    Margin="175,20,0,0"
    VerticalAlignment="Top"
    Foreground="Black"
    Width="74"
    FontFamily="Forte"/>
                    <Label
    Content="Your Name:"
    HorizontalAlignment="Left"
    Margin="10,86,0,0"
    VerticalAlignment="Top"
    Foreground="Black"
    FontFamily="Forte"/>

                    <TextBox x:Name="ip"
         HorizontalAlignment="Left"
         Height="25"
         Margin="10,46,0,0"
         TextWrapping="Wrap"
         Text="192.168.0.107"
         VerticalAlignment="Top"
         Width="155"
         VerticalContentAlignment="Center"
         HorizontalContentAlignment="Center"
         FontFamily="Forte"/>

                    <TextBox x:Name="port"
         HorizontalAlignment="Left"
         Height="25"
         Margin="175,46,0,0"
         TextWrapping="Wrap"
         Text="5000"
         VerticalAlignment="Top"
         Width="54"
         VerticalContentAlignment="Center"
         HorizontalContentAlignment="Center"
         FontFamily="Forte"/>

                    <TextBox x:Name="name"
         Height="25"
         Margin="10,112,20,0"
         TextWrapping="Wrap"
         Text="Alexashcka"
         VerticalAlignment="Top"
         VerticalContentAlignment="Center"
         HorizontalContentAlignment="Center"
         FontFamily="Forte"/>

                    <Button Click="StartGame"
        Content="Game"
        HorizontalAlignment="Left"
        Margin="10,142,0,0"
        VerticalAlignment="Top"
        Width="219"
        Height="25"
        FontFamily="Forte"/>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Page>