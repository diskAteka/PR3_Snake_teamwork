<Page x:Class="Pr3_snake.Pages.EndGame"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr3_snake.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EndGame">

    <Grid>
        <Grid.Background>
            <ImageBrush  ImageSource="/Pr3_snake;component/Images/img_backgroung.png"/>
        </Grid.Background>
        <Grid>
            <Grid Width="320"
                  Height="280"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.Background>
                    <ImageBrush ImageSource="/Pr3_snake;component/Images/img_scroll.png"/>
                </Grid.Background>

                <Label
                    x:Name="name"
                    Content="Alexashchka"
                    Margin="45,64,45,0"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    FontFamily="Forte"
                    FontSize="16"/>

                <Label
                    x:Name="glasses"
                    Content="90 glasses"
                    Margin="45,90,45,0"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    FontFamily="Forte"/>

                <Button Click="OpenHome"
                        Content="Main Menu"
                        HorizontalAlignment="Center"
                        Margin="0,191,0,0"
                        VerticalAlignment="Top"
                        Width="150"
                        Height="25" FontFamily="Forte"/>

                <Label x:Name="top"
                       Content="999"
                       Margin="72,121,72,0"
                       VerticalAlignment="Top"
                       HorizontalContentAlignment="Center"
                       FontFamily="Forte"
                       Height="65" VerticalContentAlignment="Center" FontSize="48"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
